{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "AiSettings": {
        "ApiKey": "",        
        "Model": "gpt-4o"        
    },

    "RagSettings": {
        "QdrantHost": "localhost",
        "QdrantPort": 6334,
        "CollectionName": "documents",
        "EmbeddingModel": "text-embedding-3-small",
        "EmbeddingVectorSize": 1536,
        "SemanticChunkerTokenLimit": 512,
        "RerankMethod": "None",
        "RerankerModel": "gpt-4o-mini",
        "MaxChunkingInputCharacters": 12000,
        "RetrievalCandidateMultiplier": 4,
        "MinSimilarityScore": 0.25,
        "MaxContextCharacters": 12000
    },

    "CrossEncoderSettings": {
        "BaseUrl": "https://api.jina.ai/v1/rerank",
        "Model": "jina-reranker-v2-base-multilingual",
        "ApiKey": "",
        "TimeoutSeconds": 30
    },

    "ProxySettings": {
        "Enabled": true,
        "Ip": "",
        "Port": 1300,
        "Login": "",
        "Password": ""
    }
}
